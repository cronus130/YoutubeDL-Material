# Copy to .env and adjust. .env is gitignored - it holds the Pushover secrets.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Relative paths resolve against this folder. If the existing deployment keeps
# its media elsewhere, point these at those folders so nothing gets re-created
# empty. Synology absolute paths look like /volume1/docker/youtubedl-material.
APPDATA_PATH=./appdata
AUDIO_PATH=./audio
VIDEO_PATH=./video
SUBSCRIPTIONS_PATH=./subscriptions
USERS_PATH=./users
DB_PATH=./db

APP_PORT=8998
TZ=Pacific/Honolulu

# This fork's image, built by .github/workflows/docker.yml on push to master.
# The GUI changes (top-bar yt-dlp widget, VPN toggle) only exist in this build.
#
# First deploy: make the GHCR package public, or `docker login ghcr.io` on the
# NAS with a personal access token that has read:packages - GHCR packages are
# private until you change their visibility.
#
# If you ever switch back to upstream (tzahi12345/youtubedl-material), use a
# `nightly` tag and never `latest`; see the comment in docker-compose.yml.
APP_IMAGE=ghcr.io/cronus130/youtubedl-material
APP_IMAGE_TAG=nightly

# Owner of appdata/, used for the updater's `user:` so the binary it writes
# stays executable by the app. The app image defaults to 1000:1000. Confirm with:
#   sudo stat -c '%u:%g' <APPDATA_PATH>/bin
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------
# yt-dlp updater
# ---------------------------------------------------------------------------
# stable  - tagged releases. The app's own updater agrees with this, so the two
#           never disagree about what should be installed.
# nightly - site breakages are often fixed here days before a tagged release.
#           Slightly higher chance of a transient regression, which is what the
#           rollback script covers. See README "Channels" for the caveat about
#           what the app's Settings page will report.
# master  - every merged commit. Not recommended.
# Or pin an exact version, e.g. 2025.01.15
YTDLP_CHANNEL=stable

# standalone - self-contained Linux binary (yt-dlp_linux). Does not use the app
#              image's python3, so yt-dlp dropping support for old Python
#              versions cannot break downloads. Recommended.
# zip        - the Python zipapp the app downloads by default. Runs on the app
#              image's python3 (currently 3.10, which yt-dlp already warns about).
YTDLP_FLAVOR=standalone

UPDATE_INTERVAL_HOURS=12
RUN_ON_START=true
# Delay before the first check, so the app finishes its own boot-time binary
# check first instead of the two racing over appdata/bin.
STARTUP_DELAY_SECONDS=60
KEEP_BACKUPS=5

# Keeps the app's own (unverified, non-atomic) downloader from replacing the
# binary this sidecar installed. Leave true unless you are debugging.
PIN_APP_UPDATER=true

# Optional end-to-end check after each update: metadata-only, nothing is
# downloaded. If it fails, the update is rolled back automatically. Leave empty
# to skip. Pick something stable and unlikely to be geo-blocked.
SMOKE_TEST_URL=

# Warn when appdata/cookies.txt gets this old. Expired cookies surface as
# "unsupported site" style failures on sites that are in fact supported.
COOKIE_MAX_AGE_DAYS=30

# Optional. Only raises the GitHub API rate limit; no scopes needed.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Pushover  (fill in and set PUSHOVER_ENABLED=true)
# ---------------------------------------------------------------------------
PUSHOVER_ENABLED=false
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Notify on "already up to date" runs too. Noisy at a 12h interval.
PUSHOVER_NOTIFY_NOOP=false

# ---------------------------------------------------------------------------
# VPN egress via gluetun  -  NOT ENABLED
# ---------------------------------------------------------------------------
# Read only by docker-compose.vpn.yml, which is not part of the running stack.
# These do nothing until that overlay is explicitly passed on the command line.
# Read docs/VPN-ROUTING.md first.
#
# Nothing here touches the NAS network: no macvlan, no router policy route.
# Gluetun raises its own tunnel and serves an HTTP proxy on a private bridge.

GLUETUN_IMAGE_TAG=v3

# Provider name as gluetun spells it: mullvad, protonvpn, nordvpn, airvpn,
# windscribe, ... or 'custom' to supply your own config. Full list:
# https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard

# WireGuard credentials from the provider. Keep these out of git - .env is
# gitignored. For OpenVPN set VPN_TYPE=openvpn and use OPENVPN_USER/PASSWORD
# instead; see the provider page above for exactly which vars it needs.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Optional exit-location preference. Leave blank to let the provider choose.
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=

VPN_PROXY_PORT=8888
# 'on' logs every proxied request - useful when first testing, noisy after.
VPN_PROXY_LOG=off

# Private bridge used only for the app -> proxy hop. Pinned because gluetun's
# firewall has to name this subnet explicitly. Change it only if it collides
# with something else on the NAS; it must not overlap your LAN or the VPN's own
# tunnel range.
VPN_LINK_SUBNET=172.31.250.0/24

# After enabling the overlay, set the proxy in the app's own Settings page:
#   Settings -> Downloader -> Route downloads through VPN  (toggle on)
#   Settings -> Downloader -> VPN proxy URL: http://gluetun:8888
# The toggle is the on/off switch from then on - no compose changes needed.
